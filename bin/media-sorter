#!/usr/bin/env bash
# Compatible with Bash 3.2; configuration is data, never shell code.
# Use an installed, portable locale for this process and its children only.
# Bash may warn about its inherited locale before executing this line.
export LC_ALL=C LANG=C
set -uo pipefail
exec 3<&0
CONFIG=${MEDIA_SORTER_CONFIG:-${HOME}/.config/media-sorter/config}
CONFIG_BASE=$CONFIG
[ ! -f "${CONFIG_BASE}.movies" ] || CONFIG=${CONFIG_BASE}.movies
SOURCE='' SERVER='' USER_NAME='' DEST=''
APPLY=0
transferred=0 skipped=0 conflicted=0 failed=0 approved=0
quote() {
    # Emit POSIX single-quoted text without Bash-version-dependent substitution.
    local rest=$1
    printf "'"
    while [[ "$rest" == *"'"* ]]; do
        printf '%s%s' "${rest%%\'*}" "'\\''"
        rest=${rest#*\'}
    done
    printf "%s'" "$rest"
}
# Human-readable labels, not shell commands. Escape non-printable bytes so a
# filename cannot inject terminal controls or additional output lines.
display_path() {
    if [[ "$1" == *[![:print:]]* ]]; then
        printf '%q' "$1"
    else
        printf '%s' "$1"
    fi
}
# Decimal GB, rounded to two places with locale-independent integer arithmetic.
display_size() {
    local bytes=$1 hundredths
    if [ "$bytes" -gt 0 ] && [ "$bytes" -lt 10000000 ]; then
        printf '<0.01 GB'
    else
        hundredths=$(((bytes+5000000)/10000000))
        printf '%d.%02d GB' "$((hundredths/100))" "$((hundredths%100))"
    fi
}
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
summary() { printf 'Summary: transferred=%d skipped=%d conflicted=%d failed=%d approved=%d\n' "$transferred" "$skipped" "$conflicted" "$failed" "$approved"; }
ask() { [ -t 3 ] || return 1; printf '%s' "$1" >&2; IFS= read -r REPLY <&3; }
valid() {
    case "$SOURCE:$DEST" in *$'\n'*|*$'\r'*) return 1;; esac
    case "$SOURCE" in /*) ;; *) return 1;; esac
    case "$DEST" in /*) ;; *) return 1;; esac
    [[ "$SERVER" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || return 1
    [[ "$USER_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*$ ]] || return 1
    [ -d "$SOURCE" ] && [ -r "$SOURCE" ]
}
profile_review() {
    printf 'Media: movies\nConfiguration: %s\nLocal source: %s\nRemote library: %s@%s:%s\n' "$(display_path "$CONFIG")" "$(display_path "$SOURCE")" "$USER_NAME" "$SERVER" "$(display_path "$DEST")"
}
# Reject overlapping configured libraries on the same SSH endpoint. Aliases
# cannot prove server identity; the operator still reviews the explicit paths.
overlap() {
    local left=${1%/} right=${2%/}
    [ "$left" = "$right" ] || [[ "$left/" == "$right/"* ]] || [[ "$right/" == "$left/"* ]]
}
check_tv_separation() {
    local tv_source tv_server _tv_user tv_dest
    [ -f "${CONFIG_BASE}.tv" ] || return 0
    { IFS= read -r tv_source && IFS= read -r tv_server && IFS= read -r _tv_user && IFS= read -r tv_dest; } < "${CONFIG_BASE}.tv" || die 'Invalid TV configuration; cannot check library separation.'
    overlap "$SOURCE" "$tv_source" && die 'Movie and TV source roots overlap; choose independent roots.'
    if [ "$SERVER" = "$tv_server" ]; then
        overlap "$DEST" "$tv_dest" && die 'Movie and TV destination roots overlap; choose independent libraries.'
    fi
    return 0
}
configure() {
    local previous=$CONFIG
    # Explicit configure movies can start from legacy values, without changing
    # the legacy file. Blank answers retain displayed values.
    [ -f "$previous" ] || previous=$CONFIG_BASE
    if [ -f "$previous" ]; then
        { IFS= read -r SOURCE && IFS= read -r SERVER && IFS= read -r USER_NAME && IFS= read -r DEST; } < "$previous" || die 'Invalid existing configuration; repair it before setup.'
    fi
    ask "Absolute Movies source: [$(display_path "$SOURCE")] " || die 'Setup cancelled; interactive input required.'; SOURCE=${REPLY:-$SOURCE}
    ask "Server hostname or SSH alias: [$SERVER] " || die 'Setup cancelled.'; SERVER=${REPLY:-$SERVER}
    ask "SSH username: [$USER_NAME] " || die 'Setup cancelled.'; USER_NAME=${REPLY:-$USER_NAME}
    ask "Absolute Movies destination: [$(display_path "$DEST")] " || die 'Setup cancelled.'; DEST=${REPLY:-$DEST}
    valid || die 'Invalid settings; source must be a readable absolute directory, destination absolute, and host/user valid.'
    for path in "$SOURCE" "$DEST"; do
        case "$path" in /|*//*|*/../*|*/./*|*/..|*/.) die 'Choose a non-root path without traversal or repeated separators.';; esac
    done
    check_tv_separation
    profile_review
    printf 'This is the MOVIES library. Setup does not contact the server.\n'
    ask 'Save settings? [yes/no] ' || die 'Setup cancelled.'
    [ "$REPLY" = yes ] || die 'Setup cancelled.'
    mkdir -p -- "$(dirname -- "$CONFIG")" || die 'Cannot create configuration directory.'
    local tmp
    tmp=$(umask 077; mktemp "${CONFIG}.XXXXXX") || die 'Cannot create configuration.'
    printf '%s\n' "$SOURCE" "$SERVER" "$USER_NAME" "$DEST" > "$tmp"
    mv -f -- "$tmp" "$CONFIG" || die 'Cannot save configuration.'
    printf 'Saved %s\n' "$(display_path "$CONFIG")"
}
load() {
    if [ ! -f "$CONFIG" ]; then configure; fi
    { IFS= read -r SOURCE && IFS= read -r SERVER && IFS= read -r USER_NAME && IFS= read -r DEST; } < "$CONFIG" || die 'Invalid configuration; run configure.'
}
SSH_TRANSPORT=(ssh -o BatchMode=yes -o ConnectTimeout=10)
remote() { "${SSH_TRANSPORT[@]}" -n "$USER_NAME@$SERVER" "export LC_ALL=C LANG=C; $1"; }
help() {
    printf '%s\n' 'Usage: media-sorter configure [movies|tv] | movies [--source /path] [--apply] | tv [--source /path] [--apply] | configure-tv | --help' 'Movies accepts MKV and MP4 (case insensitive) and previews by default. --apply still requires approval for every file.' 'Requires Bash, SSH and rsync 3.x locally and remotely. TV additionally requires Python 3 locally/remotely and Linux renameat2.'
}
case "${1:---help}" in
    --help|-h) help; exit 0;;
    configure)
        case "${2:-}" in
            '') [ "$#" -eq 1 ] || die 'Use configure [movies|tv].';;
            movies) [ "$#" -eq 2 ] || die 'Use configure movies.'; CONFIG=${CONFIG_BASE}.movies;;
            tv) [ "$#" -eq 2 ] || die 'Use configure tv.'; exec python3 "$(dirname -- "$0")/../lib/tv.py" configure-tv;;
            *) die 'Supported configuration profiles: movies, tv. Music transfer is not implemented.';;
        esac
        configure; exit 0;;
    tv|configure-tv) exec python3 "$(dirname -- "$0")/../lib/tv.py" "$@";;
    movies) shift;;
    *) die 'Unsupported command; use movies, configure, or --help. both is not supported.';;
esac
override=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --apply) APPLY=1; shift;;
        --source) [ "$#" -ge 2 ] || die '--source requires a path.'; override=$2; shift 2;;
        *) die "Unknown argument: $1";;
    esac
done
trap 'printf "Interrupted; originals retained. Hidden staging files may need cleanup.\n" >&2; summary; exit 130' INT TERM
load
[ -z "$override" ] || SOURCE=$override
valid || die 'Invalid settings or unavailable source; run configure.'
check_tv_separation
profile_review
[ -t 3 ] || die 'Interactive input is required for per-file approval; nothing transferred.'
command -v rsync >/dev/null || die 'Install rsync 3.x (on macOS: brew install rsync).'
rsync --help | grep -e --protect-args -e --secluded-args >/dev/null || die 'Local rsync must support --protect-args; install rsync 3.x.'
remote "command -v rsync >/dev/null && rsync --help | grep -e --protect-args -e --secluded-args >/dev/null" || die 'SSH failed or remote rsync lacks --protect-args; check access and install rsync 3.x.'
remote "test -d $(quote "$DEST") && test -w $(quote "$DEST")" || die 'Remote destination must exist and be writable.'
[ "$APPLY" -eq 1 ] || printf 'PREVIEW: no remote library changes will be made.\n'
# Snapshot each enumeration and check find before consuming any partial output.
scan_dir=$(mktemp -d "${TMPDIR:-/tmp}/media-sorter.XXXXXX") || die 'Cannot create scan workspace.'
trap 'rm -rf -- "$scan_dir"' EXIT
: > "$scan_dir/approved" || die 'Cannot create approval list.'
printf 'Selection phase: approve all movies before any transfers.\n'
if ! find "$SOURCE" -mindepth 1 -maxdepth 1 \( -type d -o \( -type f \( -iname '*.mkv' -o -iname '*.mp4' \) \) \) -print0 > "$scan_dir/entries"; then
    printf 'Error: cannot scan source: %s\n' "$(display_path "$SOURCE")" >&2
    failed=$((failed+1)); summary; exit 1
fi
while IFS= read -r -d '' entry; do
    label='Movie folder'
    if [ -L "$entry" ]; then
        printf 'Error: source entry became a symlink: %s\n' "$(display_path "$entry")" >&2
        failed=$((failed+1)); continue
    elif [ -d "$entry" ]; then
        if ! find "$entry" -maxdepth 1 -type f \( -iname '*.mkv' -o -iname '*.mp4' \) -print0 > "$scan_dir/files"; then
            printf 'Error: cannot scan movie folder: %s\n' "$(display_path "$entry")" >&2
            failed=$((failed+1)); continue
        fi
    else
        label='Loose movie'
        printf '%s\0' "$entry" > "$scan_dir/files" || die 'Cannot prepare candidate scan.'
    fi
    files=(); sizes=()
    while IFS= read -r -d '' file; do
        # Every immediate MKV/MP4 stays selectable; names cannot establish main-feature identity.
        if ! size=$(wc -c < "$file"); then
            printf 'Error: cannot inspect candidate: %s\n' "$(display_path "$file")" >&2
            failed=$((failed+1)); files=(); break
        fi
        # Stable insertion by size, preserving arbitrary filenames and Bash 3.2.
        i=${#files[@]}
        while [ "$i" -gt 0 ] && [ "$size" -gt "${sizes[$((i-1))]}" ]; do
            files[i]=${files[$((i-1))]}
            sizes[i]=${sizes[$((i-1))]}
            i=$((i-1))
        done
        files[i]=$file
        sizes[i]=$size
    done < "$scan_dir/files"
    [ "${#files[@]}" -gt 0 ] || continue
    printf '\n%s: %s\n' "$label" "$(display_path "${entry##*/}")"
    selected=0
    i=0
    for file in "${files[@]}"; do
        printf 'Candidate: %s (%s; size is a suggestion only)\n' "$(display_path "${file##*/}")" "$(display_size "${sizes[i]}")"
        target=${DEST%/}/${file##*/}
        printf 'Destination: %s\n' "$(display_path "$target")"
        i=$((i+1))
        while :; do
            if [ "$APPLY" -eq 1 ]; then prompt='Send this file? [Y/n] '; else prompt='Preview this file? [Y/n] '; fi
            if ! ask "$prompt"; then
                printf '\nInput ended; batch cancelled. No approved files were transferred.\n' >&2
                skipped=$((skipped+1)); summary; exit 1
            fi
            case "$REPLY" in
                ''|[yY]|[yY][eE][sS]) selected=1; break;;
                [nN]|[nN][oO]) break;;
                *) printf 'Please enter Y or N (Enter means yes).\n' >&2;;
            esac
        done
        [ "$selected" -eq 0 ] || break
    done
    [ "$selected" -eq 1 ] || { skipped=$((skipped+1)); continue; }
    printf 'Selected: %s\n' "$(display_path "$file")"
    printf '%s\0' "$file" >> "$scan_dir/approved" || die 'Cannot record approval; batch cancelled.'
    approved=$((approved+1))
done < "$scan_dir/entries"
printf '\nSelection complete: %d approved file(s).\n' "$approved"
[ "$APPLY" -eq 0 ] || printf 'Transfer phase: starting approved batch.\n'
item=0
while IFS= read -r -d '' file; do
    item=$((item+1))
    target=${DEST%/}/${file##*/}
    if [ ! -f "$file" ] || [ -L "$file" ] || [ ! -r "$file" ]; then
        printf 'Error: approved source is no longer a readable regular file: %s\n' "$(display_path "$file")" >&2
        failed=$((failed+1)); continue
    fi
    remote "test ! -e $(quote "$target") && test ! -L $(quote "$target")"
    status=$?
    if [ "$status" -eq 1 ]; then printf 'Conflict: %s\n' "$(display_path "$target")"; conflicted=$((conflicted+1)); continue; fi
    if [ "$status" -ne 0 ]; then failed=$((failed+1)); continue; fi
    if [ "$APPLY" -eq 0 ]; then printf 'Would transfer to %s\n' "$(display_path "$target")"; continue; fi
    printf '\nTransferring %d/%d: %s\n' "$item" "$approved" "$(display_path "${file##*/}")"
    stage=${DEST%/}/.media-sorter-$$-$RANDOM-$RANDOM
    # mkdir is exclusive; a partial payload never has the final media filename.
    if ! remote "mkdir -- $(quote "$stage")"; then failed=$((failed+1)); continue; fi
    if rsync --protect-args --progress --rsync-path="env LC_ALL=C LANG=C rsync" -e "${SSH_TRANSPORT[*]}" -t -- "$file" "$USER_NAME@$SERVER:$stage/payload"; then
        # Hard-link publication is atomic and fails if a final file already exists.
        remote "ln -T -- $(quote "$stage/payload") $(quote "$target")"
        result=$?
        if [ "$result" -eq 0 ]; then transferred=$((transferred+1)); else failed=$((failed+1)); fi
    else
        failed=$((failed+1))
    fi
    remote "rm -f -- $(quote "$stage/payload") && rmdir -- $(quote "$stage")" || printf 'Warning: staging cleanup failed: %s\n' "$(display_path "$stage")" >&2
done < "$scan_dir/approved"
summary
[ "$failed" -eq 0 ]
